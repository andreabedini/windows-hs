cabal-version:   3.4
name:            hello
version:         0.1.0.0
synopsis:        Sample program using bindings generated by windows-bindgen
build-type:      Simple

common warnings
  ghc-options:      -Wall -Wcompat
  default-language: GHC2024

-- The generated bindings and the sample code are in the library, so that
-- they are type-checked on every platform. Only the executable needs
-- Windows to link and run.
library
  import:          warnings
  hs-source-dirs:  src
  exposed-modules:
    Hello
    Windows.Win32

  build-depends:
    , base
    , windows-core

executable hello
  import:         warnings
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base
    , hello

  if !os(windows)
    buildable: False
