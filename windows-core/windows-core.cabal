cabal-version:   3.4
name:            windows-core
version:         0.1.0.0
synopsis:        Runtime support for bindings generated by windows-bindgen
description:
  The small runtime that Haskell bindings generated from win32metadata
  depend on: resolving functions from DLLs at runtime, marshalling structs
  passed by value, fixed-size arrays, GUIDs, string constants, and
  Windows error codes.

category:        System, Windows
author:          Andrea Bedini
maintainer:      andrea@andreabedini.com
build-type:      Simple
tested-with:     GHC ==9.12.2

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints
    -Wmissing-deriving-strategies

  default-language: GHC2024

library
  import:          warnings
  hs-source-dirs:  src
  exposed-modules:
    Windows.Core
    Windows.Core.Error
    Windows.Core.FixedArray
    Windows.Core.GUID
    Windows.Core.HRESULT
    Windows.Core.Link
    Windows.Core.Literal
    Windows.Core.Marshal
    Windows.Core.Member

  build-depends:
    , base        >=4.19 && <5
    , containers  >=0.6  && <0.8

  -- The library also builds on other systems so that generated bindings
  -- can be type-checked there; only linking a program needs Windows.
  if os(windows)
    extra-libraries: kernel32

-- Tests only the modules that call no Windows functions, which link on
-- every system.
test-suite windows-core-test
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , base
    , windows-core
